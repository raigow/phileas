<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="ERROR">
    <Appenders>
        <Console name="console" target="SYSTEM_ERR">
            <PatternLayout pattern="[%-5level] %c{1} - %msg%n" />
        </Console>
    </Appenders>
    <Loggers>
        <Root level="error">
            <AppenderRef ref="console" />
        </Root>
    </Loggers>
</Configuration>
